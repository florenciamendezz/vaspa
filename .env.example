# ==============================================================================
# VASPA - Plantilla de Variables de Entorno (.env.example)
# Copie este archivo como .env y complete con las credenciales locales seguras.
# ==============================================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/vaspa

# Conexión a Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bdgef_vaspa
DB_CHARSET=utf8

# Configuración de Servidor de Correo (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
FORZAR_ENVIO_MAIL=false

# Cuentas Institucionales y de Notificación (Completar con Contraseñas de Aplicación)
MAIL_SISTEMA_USER=sistema@uarg.unpa.edu.ar
MAIL_SISTEMA_PASS=tu_contraseña_aplicacion_aqui
MAIL_SA_USER=sec_academica@uarg.unpa.edu.ar
MAIL_SA_PASS=tu_contraseña_aplicacion_aqui
MAIL_DEPTO_CS_USER=depto_cs@uarg.unpa.edu.ar
MAIL_DEPTO_CS_PASS=tu_contraseña_aplicacion_aqui
MAIL_DEPTO_CNE_USER=depto_cne@uarg.unpa.edu.ar
MAIL_DEPTO_CNE_PASS=tu_contraseña_aplicacion_aqui
MAIL_PROFESOR_USER=profesor@uarg.unpa.edu.ar
MAIL_PROFESOR_PASS=tu_contraseña_aplicacion_aqui
MAIL_ESCUELA_USER=escuela@uarg.unpa.edu.ar
