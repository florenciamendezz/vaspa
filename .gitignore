# Variables de entorno y secretos locales
.env
.env.local
.env.*.local
tools.yaml
*.yaml
*.yml

# Excepciones para archivos de configuración e infraestructura
!docker-compose.yml
!docker-compose.*.yml
!.github/
!.github/**/*.yml
!.github/**/*.yaml

# Permitir template de variables de entorno
!.env.example

# Dependencias Composer y librerías instaladas
/vendor/
/tests/e2e/node_modules/

# Backups y volcados de base de datos
*.sql
*.sql.gz
*.bak
*.dump
scriptBD/backup_*.sql

# Mantener los scripts base de instalación de la base de datos
!scriptBD/01_bdusuarios.sql
!scriptBD/02_ESTRUCTURA - bdgef_vaspa.sql
!scriptBD/03_DATOS - bdgef_vaspa.sql
