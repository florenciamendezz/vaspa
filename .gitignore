# Pruebas y artefactos temporales
/pruebas-playwright/
/pruebas-playwright/node_modules/
/test-results/
/tests/e2e/test-results/
/tests/e2e/playwright-report/

# Archivos PDF generados o subidos en pruebas
/archivos/programas/*.pdf
/uploads/*.pdf

# Artefactos temporales de subagentes (manteniendo las reglas del proyecto)
/.agents/teamwork/

