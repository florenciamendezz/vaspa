# ==============================================================================
# VASPA - Denegación Total de Acceso Web a Directorio de Scripts SQL
# ==============================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
