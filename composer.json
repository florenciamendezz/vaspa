{
  "name": "uarg-unpa/vaspa",
  "description": "VASPA - Validador y Administrador de Programas Analíticos (UARG-UNPA)",
  "type": "project",
  "license": "proprietary",
  "keywords": [
    "vaspa",
    "unpa",
    "uarg",
    "programas-analiticos",
    "gestion-academica"
  ],
  "authors": [
    {
      "name": "Equipo de Desarrollo y Seguridad VASPA",
      "email": "sistema@uarg.unpa.edu.ar",
      "role": "Mantenimiento y Seguridad"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "phpmailer/phpmailer": "^6.9",
    "tecnickcom/tcpdf": "^6.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "classmap": [
      "lib/Constantes.Class.php",
      "lib/ControlAcceso.Class.php",
      "lib/Env.Class.php",
      "lib/funcionesUtiles/",
      "lib/notificacionesMail/",
      "modelo/",
      "modeloSistema/",
      "controlSistema/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "lint": "php scripts/lint.php",
    "test": "npm --prefix tests/e2e test",
    "check-composer": "composer validate --strict"
  }
}
