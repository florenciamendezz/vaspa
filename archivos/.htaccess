# VASPA - Bloqueo estricto de ejecucion de scripts en carpeta de subidas (SEC-008)
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .asp .aspx .shtml
SetHandler default-handler

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i:\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe|sh|bat|cmd|jsp|asp|aspx|py|shtml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i:\.pdf)$">
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set Content-Disposition "inline"
    </IfModule>
</FilesMatch>
